# ==========================================
# Clerk Authentication Configuration
# ==========================================
# Publishable key for client-side Clerk operations
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Secret key for server-side auth validation (Never expose to client)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Route Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ==========================================
# Supabase Configuration
# ==========================================
# Supabase Project REST Endpoint URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Publishable API Key (Used with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (Server actions only, bypasses RLS for background triggers)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
